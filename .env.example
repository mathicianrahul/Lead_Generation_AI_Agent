# LeadPilot AI - Environment Configuration Example
# Copy this file to .env and configure your keys

# Google Places API (Required for live discovery)
# Note: Restrict this key in Google Cloud Console to Places API
GOOGLE_MAPS_API_KEY=AIzaSyB3qxctAcnCj4liKjfFV5jnB8CTGv7CyHQ

# LLM Configuration (Optional: core lead workflow operates without LLM)
# Supported providers: huggingface, openai, mock
LLM_PROVIDER=huggingface
HUGGINGFACE_API_TOKEN=
LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# Gmail OAuth 2.0 (Optional: required only for sending approved emails via Gmail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# Application Database
DATABASE_URL=sqlite:///leadpilot.db

# Application Environment (development, production)
APP_ENV=development

# Demo Mode: if true or if GOOGLE_MAPS_API_KEY is not set, allows test search with clear mock indicator
DEMO_MODE=true

# Operational Safety Limits
MAX_DAILY_EMAILS=10
MAX_SEARCH_RESULTS=100
DEFAULT_MIN_LEAD_SCORE=60
HTTP_TIMEOUT_SECONDS=10

